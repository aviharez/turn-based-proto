; Engine configuration file.
; Godot 4.7.2. Edit through the editor where possible.

config_version=5

[application]

config/name="Runedeep"
config/description="Turn-based tactical RPG with roguelike expeditions and a settlement you build."
config/version="0.0.1"
run/main_scene="res://src/view/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

DevCapture="*res://src/view/debug/dev_capture.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://src/content/text/ui.en.translation", "res://src/content/text/ui.id.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
